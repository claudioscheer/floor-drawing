{
  "name": "floor-drawing",
  "version": "1.0.0",
  "description": "TypeScript floor plan editor (Alpine + interact.js)",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8765 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:all": "vitest run && node tests/e2e/smoke.mjs",
    "server": "tsx server/src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "alpinejs": "^3.15.12",
    "dotenv": "^17.4.2",
    "hono": "^4.11.3",
    "interactjs": "^1.10.28",
    "pg": "^8.16.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.6",
    "@types/three": "^0.185.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
